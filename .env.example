# Copy to .env and fill in locally. Never commit .env.
# Every setting is optional in Phase 1; the app runs without any of them.

# --- Application database (direct SQLAlchemy connection, used from Phase 2) ---
# 5433 is the port observed during the Phase 1 setup inspection (not the default 5432).
# Setting it here does not verify it; the app makes no connection in Phase 1.
ADS_DB_HOST=localhost
ADS_DB_PORT=5433
ADS_DB_NAME=
ADS_DB_USER=
ADS_DB_PASSWORD=

# MCP server credentials do NOT belong here. The MCP server uses its own
# read-only role. Planned: a committed .mcp.json that only references environment
# variables. Not yet installed, configured or verified.
# See docs/postgres-mcp-integration.md.
